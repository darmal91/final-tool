{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/assets/[businessId]",
      "regex": "^/api/assets/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbusinessId": "nxtPbusinessId"
      },
      "namedRegex": "^/api/assets/(?<nxtPbusinessId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/assets/[businessId]/[filename]",
      "regex": "^/api/assets/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbusinessId": "nxtPbusinessId",
        "nxtPfilename": "nxtPfilename"
      },
      "namedRegex": "^/api/assets/(?<nxtPbusinessId>[^/]+?)/(?<nxtPfilename>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/export/[businessId]",
      "regex": "^/api/export/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbusinessId": "nxtPbusinessId"
      },
      "namedRegex": "^/api/export/(?<nxtPbusinessId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/projects/[businessId]",
      "regex": "^/api/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbusinessId": "nxtPbusinessId"
      },
      "namedRegex": "^/api/projects/(?<nxtPbusinessId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/editor/[businessId]",
      "regex": "^/editor/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbusinessId": "nxtPbusinessId"
      },
      "namedRegex": "^/editor/(?<nxtPbusinessId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/preview/[businessId]",
      "regex": "^/preview/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbusinessId": "nxtPbusinessId"
      },
      "namedRegex": "^/preview/(?<nxtPbusinessId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/new",
      "regex": "^/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/new(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}